configuration {
    modi: "clipboard";
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "kitty";

    display-clipboard: "  Clipboard ";

    kb-row-up: "Up,Control+p";
    kb-row-down: "Down,Control+n";
    kb-accept-entry: "Return,KP_Enter,Control+y";
}

* {
    font: "JetBrainsMono Nerd Font 10";

    /* Niri grayscale palette (focus ring active #404040 -> #606060,
       inactive #505050 -> #808080, urgent #9b0000) */
    base:        #000000cc;   /* 80% opacity */
    mantle:      #181818cc;   /* near black */
    crust:       #111111cc;   /* darker */
    surface0:    #222222cc;   /* dark gray */
    surface1:    #2f2f2fcc;   /* mid gray */
    surface2:    #404040cc;   /* light gray border */
    overlay1:    #7f7f7fcc;   /* overlay text gray */
    overlay2:    #969696cc;   /* lighter overlay */
    blue:        #404040cc;   /* niri active focus ring */
    lavender:    #606060cc;   /* niri active gradient end */
    sky:         #505050cc;   /* niri inactive focus ring */
    red:         #9b0000;     /* niri urgent color */
    text:        #ffffff;

    background-color: @base;
    text-color: #ffffff;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 55%;
    height: 60%;
    transparency: "real";
    blur: true;
    background-color: @base;
    border: 1px;
    border-color: @surface2;
    border-radius: 0px;
    padding: 8px;
}

mainbox {
    children: [inputbar, listview];
    background-color: transparent;
    spacing: 8px;
    padding: 8px;
}

inputbar {
    children: [textbox-prompt-colon, entry, num-filtered-rows];
    background-color: @surface1;
    border-radius: 0px;
    padding: 8px;
    border: 1px;
    border-color: @surface2;
    spacing: 10px;
}

textbox-prompt-colon {
    expand: false;
    str: "✦ ❯";
    background-color: transparent;
    text-color: #ffffff;
    font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder: "Search clipboard...";
    placeholder-color: @overlay1;
    text-color: #ffffff;
    background-color: transparent;
}

num-filtered-rows {
    text-color: #ffffff;
    expand: false;
    background-color: transparent;
    text-color: #ffffff;
    font: "JetBrainsMono Nerd Font Bold 11";
}

listview {
    lines: 12;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    scrollbar: true;
    background-color: transparent;
    border-radius: 0px;
    margin: 0 6px;
    spacing: 6px;
    padding: 8px;
}

scrollbar {
    width: 1px;
    border-radius: 4px;
    background-color: @surface1;
    handle-color: @blue;
    handle-width: 2px;
    padding: 0;
}

element {
    padding: 8px 12px;
    margin: 2px 0;
    border-radius: 0px;
    spacing: 10px;
    cursor: pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: #ffffff;
}

element selected.normal {
    background-color: @blue;
    text-color: #ffffff;
    border: 1px;
    border-color: @lavender;
    border-radius: 0px;
}

element-icon {
    size: 18px;
    padding: 0 8px 0 0;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    highlight: none;
    text-overflow: "…";
}

button {
    text-color: #ffffff;
    border-radius: 0px;
    background-color: @surface2;
    padding: 6px 8px;
    horizontal-align: 0.5;
    border: 1px;
    border-color: transparent;
}

button selected {
    background-color: @blue;
    text-color: #ffffff;
    border-color: @lavender;
}

error-message {
    background-color: @red;
    text-color: #ffffff;
    border-radius: 0px;
    padding: 12px;
}

element.urgent {
    background-color: rgba(155, 0, 0, 0.2);
}

element.active {
    background-color: rgba(64, 64, 64, 0.2);
}
