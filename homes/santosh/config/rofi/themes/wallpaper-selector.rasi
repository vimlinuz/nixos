/* Wallpaper Selector - Vague Style */

configuration {
    show-icons: true;
}

* {
    font: "JetBrainsMono Nerd Font 10";
    /* Vague Colors with transparency */
    base:        #141415d9;   /* bg, 85% opacity */
    mantle:      #1c1c24d9;   /* inactive bg */
    crust:       #101012d9;
    surface0:    #252530d9;   /* line */
    surface1:    #333738d9;   /* visual */
    surface2:    #878787d9;   /* border */
    text:        #cdcdcd;
    subtext1:    #d7d7d7;
    subtext0:    #878787;
    overlay2:    #9b9b9b;
    overlay1:    #878787;
    overlay0:    #606079;
    blue:        #7e98e8;
    lavender:    #aeaed1;
    sapphire:    #6e94b2;
    sky:         #b4d4cf;
    teal:        #b4d4cf;
    green:       #7fa563;
    yellow:      #f3be7c;
    peach:       #e8b589;
    maroon:      #c48282;
    red:         #d8647e;
    mauve:       #aeaed1;
    pink:        #bb9dbd;
    flamingo:    #bb9dbd;
    rosewater:   #c9b1ca;
    background-color: @base;
    text-color: @text;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 1200px;
    height: 600px;
    transparency: "real";
    blur: true;
    background-color: @base;
    border: 2px;
    border-color: @surface2;
    border-radius: 18px;
    padding: 8px;
}

mainbox {
    orientation: horizontal;
    spacing: 8px;
    padding: 8px;
    background-color: transparent;
    children: [preview, listarea];
}

preview {
    expand: true;
    background-image: url("~/.current_wallpaper", height);
    border-radius: 18px;
}

listarea {
    orientation: vertical;
    background-color: transparent;
    spacing: 8px;
    children: [inputbar, listview];
}

inputbar {
    background-color: @surface1;
    border-radius: 14px;
    padding: 8px;
    border: 1px;
    border-color: @surface2;
    children: [textbox-prompt-colon, entry];
}

textbox-prompt-colon {
    expand: false;
    str: "✦ ❯ ";
    background-color: transparent;
    text-color: @blue;
    font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder: "Search wallpaper...";
    placeholder-color: @overlay1;
    text-color: @text;
    background-color: transparent;
    padding: 0;
}

listview {
    lines: 10;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    scrollbar: true;
    background-color: transparent;
    border-radius: 14px;
    margin: 0 12px;
    spacing: 12px;
    padding: 8px 0 8px 0;
    width: 100%;
}

scrollbar {
    width: 2px;
    border-radius: 4px;
    background-color: @surface1;
    handle-color: @blue;
    handle-width: 4px;
    padding: 0;
}

element {
    padding: 5px;
    margin: 3px;
    border-radius: 12px;
    spacing: 4px;
    children: [element-icon, element-text];
}

element normal.normal,
element alternate.normal {
    background-color: @surface1;
    text-color: @text;
}

element selected.normal {
    background-color: @blue;
    text-color: #000000;
    border: 1px;
    border-color: @lavender;
    border-radius: 12px;
}

element-icon {
    size: 100px;
    border-radius: 10px;
    background-color: #cdcdcd22;
    padding: 0;
}

element-text {
    background-color: transparent;
    text-color: @text;
    font: "JetBrainsMono Nerd Font 10";
    font-weight: 400;
    padding: 2px 0 0 0;
    vertical-align: 0.5;
    text-overflow: "…";
}

element-text selected.normal {
    text-color: #141415;
}


button {
    text-color: @overlay1;
    border-radius: 12px;
    background-color: @surface2;
    padding: 6px 8px;
    horizontal-align: 0.5;
    border: 1px;
    border-color: transparent;
}

button selected {
    background-color: @blue;
    text-color: @base;
    border-color: @lavender;
}

error-message {
    background-color: @red;
    text-color: @base;
    border-radius: 12px;
    padding: 12px;
}

element.urgent {
    background-color: rgba(216, 100, 126, 0.2);
}

element.active {
    background-color: rgba(126, 152, 232, 0.2);
}
